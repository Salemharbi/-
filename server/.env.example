# مفتاح Anthropic الحقيقي يبقى هنا فقط، ولا يُرسل إلى التطبيق أبداً
ANTHROPIC_API_KEY=

# النموذج الافتراضي (يمكن تغييره)
ANTHROPIC_MODEL=claude-opus-5-5

# رمز يرسله التطبيق في الترويسة: Authorization: Bearer <APP_API_TOKEN>
APP_API_TOKEN=

# المنفذ
PORT=8787

# تفعيل تحويل الرفض تلقائياً لنموذج احتياطي: default أو off
REFUSAL_FALLBACK=default

# حد الطلبات لكل مفتاح في الدقيقة
RATE_LIMIT_PER_MINUTE=30
